{
  "name": "@draggable/i18n",
  "version": "1.1.1",
  "description": "A simple yet robust i18n solution for universal JavaScript apps.",
  "main": "dist/i18n.es.min.js",
  "module": "dist/i18n.es.min.js",
  "types": "dist/i18n.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/i18n.d.ts",
        "default": "./dist/i18n.es.min.js"
      },
      "require": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      },
      "default": "./dist/i18n.es.min.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "node --test src/**/*.test.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:dist": "node test/dist.test.js",
    "test:watch": "node --test --watch src/**/*.test.js",
    "lint": "biome lint ./src",
    "lint:fix": "biome format ./src --write",
    "start": "webpack-dev-server --mode development",
    "semantic-release": "semantic-release",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "npm run test:dist",
    "preview": "vite preview"
  },
  "repository": {
    "url": "https://github.com/Draggable/i18n",
    "type": "git"
  },
  "keywords": [
    "i18n"
  ],
  "author": "Draggable https://draggable.io",
  "contributors": [
    {
      "name": "Kevin Chappell",
      "email": "kevin@chappell.dev",
      "url": "https://kevin-chappell.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Draggable/i18n/issues"
  },
  "homepage": "https://github.com/Draggable/i18n",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "lefthook": "^1.7.22",
    "lint-staged": "^17.0.3",
    "semantic-release": "^25.0.3",
    "terser": "^5.47.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.6",
    "vite-plugin-banner": "^0.8.0",
    "vite-plugin-compression": "^0.5.1"
  },
  "lint-staged": {
    "src/**/*.js": [
      "biome lint",
      "biome format",
      "git add"
    ]
  },
  "release": {
    "branch": "master",
    "verifyConditions": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git"
    ],
    "prepare": [
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "style",
          "test"
        ]
      ]
    }
  }
}
